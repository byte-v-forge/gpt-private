{
  "id": "gpt-gopay-payment-rebind",
  "name": "GPT GoPay Payment Rebind",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gpt/gopay-payment-rebind",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 202
        }
      },
      "id": "gpt-gopay-payment-rebind-start-webhook",
      "name": "Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "byte-v-forge-gpt-gopay-payment-rebind"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "job-id",
              "name": "job_id",
              "value": "={{ $json.body?.job_id || $json.job_id }}",
              "type": "string"
            },
            {
              "id": "account-id",
              "name": "account_id",
              "value": "={{ $json.body?.account_id || $json.account_id }}",
              "type": "string"
            },
            {
              "id": "n8n-execution-id",
              "name": "n8n_execution_id",
              "value": "={{ $execution.id }}",
              "type": "string"
            },
            {
              "id": "action-scope",
              "name": "action_scope",
              "value": "gopay-payment-rebind",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "gpt-gopay-payment-rebind-normalize-input",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GPT_ACTION_API_BASE_URL + '/gopay-payment-rebind/resolve-source' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { job_id: $('Normalize Input').first().json.job_id, account_id: $('Normalize Input').first().json.account_id, n8n_execution_id: $('Normalize Input').first().json.n8n_execution_id } }}",
        "options": {}
      },
      "id": "gpt-gopay-payment-rebind-resolve-source",
      "name": "Resolve Source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GOPAY_ACTION_API_BASE_URL + '/gopay-payment/load-state' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { job_id: $('Normalize Input').first().json.job_id, account_id: $('Resolve Source').first().json.account_id, n8n_execution_id: $('Normalize Input').first().json.n8n_execution_id, gopay_account_id: $('Resolve Source').first().json.gopay_account_id } }}",
        "options": {}
      },
      "id": "gpt-gopay-payment-rebind-load-state",
      "name": "Load State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "gpt-gopay-payment-auth",
          "mode": "id"
        }
      },
      "id": "gpt-gopay-payment-rebind-auth",
      "name": "Auth",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1280,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "gpt-gopay-payment-change-phone",
          "mode": "id"
        }
      },
      "id": "gpt-gopay-payment-rebind-change-phone",
      "name": "Change Phone",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1600,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GPT_ACTION_API_BASE_URL + '/gopay-payment-rebind/finish' }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { job_id: $('Normalize Input').first().json.job_id, account_id: $('Resolve Source').first().json.account_id, n8n_execution_id: $('Normalize Input').first().json.n8n_execution_id, gopay_account_id: $('Resolve Source').first().json.gopay_account_id, activation_id: $('Change Phone').first().json.activation_id, phone: $('Change Phone').first().json.phone, data: { rebind_source: $('Resolve Source').first().json.data, load_state: $('Load State').first().json.data, auth: $('Auth').first().json.data, change_phone: $('Change Phone').first().json.data } } }}",
        "options": {}
      },
      "id": "gpt-gopay-payment-rebind-finish",
      "name": "Finish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "Resolve Source",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve Source": {
      "main": [
        [
          {
            "node": "Load State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load State": {
      "main": [
        [
          {
            "node": "Auth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auth": {
      "main": [
        [
          {
            "node": "Change Phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Change Phone": {
      "main": [
        [
          {
            "node": "Finish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "tags": []
}
